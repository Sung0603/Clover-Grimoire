<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Título Principal -->
    <TextView
        android:id="@+id/tv_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="Clover Grimoire - Personagens"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtítulo / Dica de Interação -->
    <TextView
        android:id="@+id/tv_main_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_main_title"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:text="Toque no card para abrir • Segure para excluir"
        android:textSize="12sp"
        android:textStyle="italic" />

    <!-- Lista de Personagens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_characters"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/container_bottom_actions"
        android:layout_below="@id/tv_main_hint"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Ações do Rodapé -->
    <LinearLayout
        android:id="@+id/container_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Criar Nova Ficha" />
    </LinearLayout>

</RelativeLayout>